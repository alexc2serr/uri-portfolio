# Configuración de Supabase (Copia estas claves desde el panel de Supabase: Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Código secreto maestro para entrar al panel /admin sin esperar a Supabase (puedes cambiarlo)
NEXT_PUBLIC_ADMIN_PASSCODE=uri2025

